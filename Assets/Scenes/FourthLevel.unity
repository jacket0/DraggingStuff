--- !u!114 &1320998324
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1320998316}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 8811cbdd22e790b46bbc83b9950e419b, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  _session: {fileID: 1965460504}
  _closedShelves: {fileID: 1320998318}
  _catalog: {fileID: 11400000, guid: 457c53a40ec04ac459ae75494fe590d2, type: 2}
  _camera: {fileID: 963194227}
  _bubble: {fileID: 1012717943}
  _bubbleGroup: {fileID: 1012717940}
  _text: {fileID: 940002640}
  _hopInterval: 0.3
  _stepDuration: 3.5
  _fadeDuration: 0.25
  _bubbleOffset: {x: 0, y: -24}
  _collectText:
    _ru: "\u0421\u043E\u0431\u0435\u0440\u0438 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0441 \u0431\u0438\u0440\u043A\u0438, \u0447\u0442\u043E\u0431\u044B \u043E\u0442\u043A\u0440\u044B\u0442\u044C
      \u043F\u043E\u043B\u043A\u0443"
    _en: Collect the items shown on the tag to open the shelf
    _tr: "Raf\u0131 a\xE7mak i\xE7in etiketteki e\u015Fyalar\u0131 topla"
  _refillText:
    _ru: "\u041F\u043E\u043A\u0430 \u043F\u043E\u043B\u043A\u0430 \u0437\u0430\u043A\u0440\u044B\u0442\u0430,
      \u043D\u043E\u0432\u044B\u0435 \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B
      \u0431\u0443\u0434\u0443\u0442 \u043F\u043E\u044F\u0432\u043B\u044F\u0442\u044C\u0441\u044F
      \u0441\u043D\u043E\u0432\u0430 \u0438 \u0441\u043D\u043E\u0432\u0430"
    _en: While a shelf is closed, new items keep appearing
    _tr: "Raf kapal\u0131yken yeni e\u015Fyalar gelmeye devam eder"
  _shelfMatchesText:
    _ru: "\u0421\u043E\u0431\u0438\u0440\u0430\u0439 \u0442\u0440\u043E\u0439\u043A\u0438
      \u043D\u0430 \u043F\u043E\u0434\u0441\u0432\u0435\u0447\u0435\u043D\u043D\u043E\u0439
      \u043F\u043E\u043B\u043A\u0435"
    _en: Make matches on the highlighted shelf
    _tr: "Vurgulanan rafta \xFC\xE7l\xFC yap"
